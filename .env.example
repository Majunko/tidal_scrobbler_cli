# Storage backend: 'sqlite' (default, local file) or 'supabase' (remote Postgres)
DB_BACKEND='sqlite'
SCROBBLE_DATABASE_NAME='scrobbles.db'

# Required only when DB_BACKEND='supabase'
SUPABASE_URL=''
SUPABASE_SERVICE_ROLE_KEY=''
# Optional: full Postgres connection string (incl. password) so migrate-to-supabase
# can auto-create the tables. Dashboard -> Connect -> PostgreSQL -> Connection
# string -> URI (direct or pooler). Only used by the migration script.
SUPABASE_DB_URL=''

LASTFM_USERNAME=''
LASTFM_API_KEY=''

LISTENBRAINZ_USERNAME='Majunko'
LISTENBRAINZ_API_TOKEN=''   # optional, recommended for higher rate limits

TIDAL_CLIENT_ID=''
TIDAL_CLIENT_SECRET=''
TIDAL_ACCESS_TOKEN=''
TIDAL_REFRESH_TOKEN=''

TIDAL_PLAYLIST_ID=''

BEATPORT_USERNAME=''
BEATPORT_PASSWORD=''
BEATPORT_API_CLIENT_ID=''
BEATPORT_ACCESS_TOKEN=''
BEATPORT_REFRESH_TOKEN=''
BEATPORT_TOKEN_EXPIRES_AT=''
